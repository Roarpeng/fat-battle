# 复制为 .env 并填写真实值（.env 已被 gitignore，不会提交）
# 用法: docker compose up -d --build  （自动读取同目录 .env）

# JWT 签名密钥（务必修改为随机长字符串，如: openssl rand -hex 32）
JWT_SECRET=dev-secret-change-me

# Redis（登出黑名单）。compose 内默认 redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# 管理后台（/admin）配置
# 独立 JWT secret（务必修改，与 App 用户体系隔离）
ADMIN_JWT_SECRET=admin-secret-change-me
# 首次启动时若 admin_users 为空，自动创建种子管理员
ADMIN_USER=admin
ADMIN_PASS=admin123456

# 食物识别密钥（已迁移到管理后台 llm_configs 表配置，无需再填；可留空）
ZHIPU_API_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
