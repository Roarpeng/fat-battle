# 塑身工坊 HTTPS 反代 — Caddy 自动申请/续期 Let's Encrypt 证书
battle.roarpeng.dpdns.org {
    encode gzip

    # 全部 API + 管理后台(/admin) 转发给后端容器
    reverse_proxy api:8080

    # 安全响应头
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
    }
}
